{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uupack",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uupack","database_id": "56baf2eb-b533-4355-b4f7-6168a48360d0",
		},
	],
	"kv_namespaces": [
		{
			// EmDash 1.0.1 分布式对象缓存（替代 1.0.1 中已移除的 cloudflareCache）
			"binding": "CACHE_KV",
			"id": "1edc35fd8deb4c43972c6904011efe42",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
